#!/usr/bin/env bash
# commit-msg hook: reject a commit whose MESSAGE contains what looks like a real
# secret. File-content scanners (git grep in CI, gitleaks default mode) never
# read commit message text, so only this hook and the matching CI step do. A
# message written with an unquoted "$ANTHROPIC_API_KEY" in a shell command is
# expanded into the real value before git sees it.
set -euo pipefail
msg_file="$1"

fail=0

# Known provider key formats, checked with grep so this runs without gitleaks.
if grep -nIE 'sk-ant-(api03|admin01)-[A-Za-z0-9_-]{20,}' "$msg_file"; then
  echo "COMMIT REJECTED: commit message contains what looks like a real Anthropic API key." >&2
  fail=1
fi
if grep -nIE '(AKIA|ASIA)[A-Z0-9]{16}' "$msg_file"; then
  echo "COMMIT REJECTED: commit message contains what looks like a real AWS access key." >&2
  fail=1
fi
if grep -nIE 'gh[pousr]_[A-Za-z0-9]{20,}' "$msg_file"; then
  echo "COMMIT REJECTED: commit message contains what looks like a real GitHub token." >&2
  fail=1
fi

# Broader net: gitleaks, when on PATH, scans the message for other known provider
# formats.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks detect --no-git --source "$msg_file" --no-banner 2>/tmp/gitleaks_commit_msg_check.log; then
    if grep -q "leaks found" /tmp/gitleaks_commit_msg_check.log 2>/dev/null || [ -s /tmp/gitleaks_commit_msg_check.log ]; then
      echo "COMMIT REJECTED: gitleaks flagged the commit message text as containing a secret:" >&2
      cat /tmp/gitleaks_commit_msg_check.log >&2
      fail=1
    fi
  fi
fi

if [ "$fail" -eq 1 ]; then
  echo "" >&2
  echo "If this is a documentation reference to an env var name (e.g. \$ANTHROPIC_API_KEY)," >&2
  echo "make sure the commit message was written with the \$VAR inside SINGLE quotes in the" >&2
  echo "shell command that created it, or via 'git commit -F <file>', so the shell never" >&2
  echo "expands it into a real value. Fix the message and try again." >&2
  exit 1
fi

exit 0
